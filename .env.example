# ===== WAHA =====
# שרת רגיל (Intel/AMD) – להשאיר כמו שזה
# שרת ARM (למשל Oracle Ampere החינמי) – לשנות ל: devlikeapro/waha:arm
WAHA_IMAGE=devlikeapro/waha:latest
# מפתח וסיסמה – להמציא משהו ארוך ואקראי
WAHA_API_KEY=להחליף-במפתח-ארוך-ואקראי
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=להחליף-בסיסמה-חזקה
TZ=Asia/Jerusalem

# ===== הקבוצות =====
# בהתחלה להשאיר ריק! (מצב למידה – ה-ID של הקבוצה יופיע בלוג)
# אחר כך: ID|שם, ואם יש כמה קבוצות – מפרידים בפסיק
# לדוגמה: GROUPS=120363012345678901@g.us|קבוצת השיעור
GROUPS=

# ===== מייל =====
MAIL_FROM=your.address@gmail.com
MAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# כמה נמענים – מפרידים בפסיק
MAIL_TO=friend@example.com

# ===== תדירות =====
# immediate = מייל על כל הודעה | hourly = פעם בשעה | daily = פעם ביום
SEND_MODE=daily
DAILY_TIME=21:00

# true = לא שולח באמת, רק מדפיס בלוג (לבדיקות)
DRY_RUN=false
